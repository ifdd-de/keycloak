{
  "ifdd_keycloak_prj_name": "IFDD Keycloak",
  "ifdd_keycloak_prj_slug": "{{ cookiecutter.ifdd_keycloak_prj_name|lower|replace(' ', '-') }}",
  "ifdd_keycloak_image": "quay.io/keycloak/keycloak:26.8.0",
  "ifdd_keycloak_postgres_image": "postgres:18",
  "ifdd_oidc_realm": "https://keycloak.example.org/realms/ifdd",
  "ifdd_keycloak_host": "{{ cookiecutter.ifdd_oidc_realm.split('://')[-1].split('/')[0] }}",
  "ifdd_keycloak_realm": "{{ cookiecutter.ifdd_oidc_realm.split('/realms/')[-1].strip('/') }}",
  "ifdd_keycloak_dev_port": "8096",
  "ifdd_keycloak_admin_user": "admin",
  "ifdd_proxy_network": "proxy-net",
  "ifdd_oidc_backend_client_id": "ifdd",
  "ifdd_oidc_jwks_audience": "{{ cookiecutter.ifdd_oidc_backend_client_id }}",
  "ifdd_be_url": "https://be.example.org",
  "ifdd_ui_url": "https://ui.example.org",
  "ifdd_be_role_nodes_read": "ifdd_nodes_ro",
  "ifdd_keycloak_role_nodes_write": "ifdd_nodes_rw",
  "ifdd_keycloak_role_public": "ifdd_public",
  "ifdd_keycloak_role_nodes_priv": "ifdd_nodes_priv",
  "ifdd_context_root": "ifdd.de",
  "ifdd_keycloak_api_client_id": "ifdd-api-script",
  "ifdd_keycloak_ct_client_id": "ifdd-ct",
  "ifdd_keycloak_useradmin_client_id": "ifdd-user-admin",
  "ifdd_ts_oidc_client_id": "ifdd-ts",
  "ifdd_ts_host": "ts.example.org",
  "ifdd_ts_role_admin": "admin",
  "ifdd_ts_role_editor": "readwrite",
  "ifdd_ts_role_viewer": "readonly",
  "ifdd_proxy_oidc_client_id": "ifdd-proxy",
  "ifdd_wf_host": "wf.example.org",
  "ifdd_keycloak_wf_admin_group": "ifdd_wf_admins",
  "ifdd_keycloak_group_nodes_readers": "ifdd_nodes_readers",
  "ifdd_keycloak_group_nodes_writers": "ifdd_nodes_writers",
  "ifdd_keycloak_group_nodes_privileged": "ifdd_nodes_privileged",
  "ifdd_keycloak_proxy_gate_hosts": "{{ cookiecutter.ifdd_wf_host }}",
  "_copy_without_render": [
    ".github",
    "tests",
    "realm/build_realm.py",
    "realm/ifdd_realm",
    "themes"
  ]
}
