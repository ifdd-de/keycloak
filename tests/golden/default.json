{
  "realm": "ifdd",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 1800,
  "accessCodeLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 86400,
  "oauth2DeviceCodeLifespan": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "loginTheme": "ifdd",
  "displayName": "IFDD Keycloak",
  "displayNameHtml": "IFDD Keycloak",
  "roles": {
    "realm": [
      {
        "name": "ifdd_public",
        "description": "Signed in, no further rights (e.g. /prot_version of ifdd-be).",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "ifdd_nodes_ro",
        "description": "Read nodes in ifdd-be.",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "ifdd_nodes_rw",
        "description": "Write nodes in ifdd-be.",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "ifdd_nodes_priv",
        "description": "Privileged read access to nodes (ifdd-ui).",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "admin",
        "description": "Grafana Admin (ifdd-ts).",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "readwrite",
        "description": "Grafana Editor (ifdd-ts).",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "readonly",
        "description": "Grafana Viewer (ifdd-ts).",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "default-roles-ifdd",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "attributes": {},
        "composites": {
          "realm": [
            "ifdd_public"
          ],
          "client": {
            "ifdd": [
              "ifdd_public"
            ]
          }
        }
      }
    ],
    "client": {
      "ifdd": [
        {
          "name": "ifdd_public",
          "description": "Signed in, no further rights.",
          "composite": false,
          "clientRole": true,
          "attributes": {}
        },
        {
          "name": "ifdd_nodes_ro",
          "description": "Read nodes.",
          "composite": false,
          "clientRole": true,
          "attributes": {}
        },
        {
          "name": "ifdd_nodes_rw",
          "description": "Write nodes.",
          "composite": false,
          "clientRole": true,
          "attributes": {}
        },
        {
          "name": "ifdd_nodes_priv",
          "description": "Privileged read access to nodes.",
          "composite": false,
          "clientRole": true,
          "attributes": {}
        },
        {
          "name": "ifdd.de",
          "description": "Context pattern: every domain context below ifdd.de.",
          "composite": false,
          "clientRole": true,
          "attributes": {}
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-ifdd"
  },
  "groups": [
    {
      "name": "ifdd_nodes_readers",
      "path": "/ifdd_nodes_readers",
      "subGroups": [],
      "realmRoles": [
        "ifdd_nodes_ro"
      ],
      "clientRoles": {
        "ifdd": [
          "ifdd_nodes_ro"
        ]
      }
    },
    {
      "name": "ifdd_nodes_writers",
      "path": "/ifdd_nodes_writers",
      "subGroups": [],
      "realmRoles": [
        "ifdd_nodes_ro",
        "ifdd_nodes_rw"
      ],
      "clientRoles": {
        "ifdd": [
